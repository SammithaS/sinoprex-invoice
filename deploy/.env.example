# deploy/.env — read by docker compose (domains, n8n). Copy to .env and fill in.
API_DOMAIN=api.example.in
N8N_DOMAIN=n8n.example.in
ACME_EMAIL=you@example.com
# Pin a current stable n8n release (see https://github.com/n8n-io/n8n/releases), e.g. 1.x.y
N8N_VERSION=
# 32+ random characters; keep it — n8n encrypts stored credentials with it.
N8N_ENCRYPTION_KEY=
