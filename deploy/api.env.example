# deploy/api.env — the API container's settings (see backend/.env.example for every option).
APP_ENV=production
# Neon: the direct (non-pooled) connection string, ?sslmode=require
DATABASE_URL=
GOOGLE_API_KEY=
GROQ_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# The Vercel URL of the frontend (CORS) and where notification deep links point.
FRONTEND_ORIGIN=https://invoiceiq.vercel.app
APP_URL=https://invoiceiq.vercel.app
# Shared with the Vercel project's API_KEY. Required in production.
API_KEY=
# n8n on the same VM (deploy/docker-compose.yml) — use its public URL.
N8N_BASE_URL=https://n8n.example.in
N8N_WEBHOOK_SECRET=
ERP_DEMO_FAULTS=true
