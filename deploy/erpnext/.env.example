# deploy/erpnext/.env — copy to .env and fill in. Keep the passwords; the site needs them.
# The site's public name, e.g. erp.<VM IP with dashes>.sslip.io (sslip.io resolves to the IP).
ERP_DOMAIN=erp.203-0-113-10.sslip.io
# Pin a current v15 release (https://hub.docker.com/r/frappe/erpnext/tags), e.g. v15.80.0
ERPNEXT_VERSION=
# 24+ random characters each.
DB_ROOT_PASSWORD=
ADMIN_PASSWORD=
# How it runs (pick one):
# on the API VM, behind its Caddy (also copy site.caddy.example to deploy/sites/erpnext.caddy):
COMPOSE_FILE=docker-compose.yml:compose.shared.yml
# on a VM of its own, with its own Caddy: remove COMPOSE_FILE above and uncomment
# COMPOSE_PROFILES=standalone
