# FastAPI. flush_interval -1 streams Server-Sent Events (live run view, Ask AP) unbuffered.
# No `encode`: compressing an event stream holds events back, and through the Vercel proxy
# the Ask AP stream was reset; responses are small and Vercel compresses for the browser.
{$API_DOMAIN} {
	reverse_proxy api:8000 {
		flush_interval -1
	}
	request_body {
		max_size 80MB
	}
}

# n8n editor + webhooks.
{$N8N_DOMAIN} {
	reverse_proxy n8n:5678
}

# Extra sites on this VM (e.g. ERPNext sharing it: see erpnext/site.caddy.example).
# No files here is fine.
import sites/*.caddy
