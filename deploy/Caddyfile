# FastAPI. flush_interval -1 streams Server-Sent Events (live run view, Ask AP) unbuffered.
{$API_DOMAIN} {
	encode zstd gzip
	reverse_proxy api:8000 {
		flush_interval -1
	}
	request_body {
		max_size 80MB
	}
}

# n8n editor + webhooks.
{$N8N_DOMAIN} {
	reverse_proxy n8n:5678
}
