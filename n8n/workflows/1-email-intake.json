        }
      },
      "id": "a59de211-efa5-56a1-9372-828e19681834",
      "name": "Gmail Trigger",
      "type": "n8n-nodes-base.gmailTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// One item per email: its PDF attachments (base64) and the exact JSON body to sign and send.\nconst out = [];\nconst items = $input.all();\nfor (let i = 0; i < items.length; i++) {\n  const item = items[i];\n  const attachments = [];\n  for (const [key, bin] of Object.entries(item.binary ?? {})) {\n    let name = bin.fileName ?? key;\n    const isPdf = bin.mimeType === 'application/pdf' || name.toLowerCase().endsWith('.pdf');\n    if (!isPdf) continue;\n    if (!name.toLowerCase().endsWith('.pdf')) name += '.pdf';\n    const buf = await this.helpers.getBinaryDataBuffer(i, key);\n    attachments.push({ filename: name, content_base64: buf.toString('base64') });\n  }\n  const m = item.json;\n  const sender = m.from?.value?.[0]?.address ?? m.from?.text ?? '';\n  const body = JSON.stringify({\n    message_id: m.id,\n    from: sender,\n    subject: m.subject ?? '',\n    received_at: m.date ?? null,\n    attachments,\n  });\n  out.push({\n    json: {\n      message_id: m.id,\n      sender,\n      subject: m.subject ?? '',\n      attachment_count: attachments.length,\n      ts: String(Math.floor(Date.now() / 1000)),\n      body,\n    },\n  });\n}\nreturn out;\n"
      },
      "id": "842d2259-5f1d-57d6-99b2-522837265c4c",
      "name": "Build request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
