        "encoding": "hex"
      },
      "id": "31e0dff6-8fce-56c6-8c37-8c799b18f53e",
      "name": "Sign",
      "type": "n8n-nodes-base.crypto",
      "typeVersion": 1,
      "position": [
        880,
        200
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.backend_url }}/intake/email",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-IIQ-Timestamp",
              "value": "={{ $json.ts }}"
            },
            {
              "name": "X-IIQ-Signature",
              "value": "=sha256={{ $json.signature }}"
            }
          ]
        },
        "options": {
          "timeout": 60000
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ $json.body }}"
      },
      "id": "0eb983b0-b932-5cea-b0e4-6a8af0655933",
      "name": "Send to Sinoprex Invoice",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        200
      ]
    },
    {
      "parameters": {
        "jsCode": "// Acknowledge the sender. No internal links: the sender may be a vendor.\nreturn $input.all().map((item) => {\n  const r = item.json;\n  const lines = ['Thank you, we have received your email.', ''];\n  for (const run of r.runs ?? []) {\n    const what = run.duplicate ? 'already received earlier' : 'received';\n    lines.push(`- ${run.file_name}: ${what} (reference ${run.run_id.slice(0, 8)})`);\n  }\n  for (const x of r.rejected ?? []) lines.push(`- ${x.filename}: not accepted (${x.reason})`);\n  lines.push('', 'Accounts Payable, Acme Retail Pvt Ltd');\n  return { json: { message_id: r.message_id, reply: lines.join('\\n') } };\n});\n"
      },
      "id": "4811fac7-b0df-56b8-bd4e-131161858f4d",
      "name": "Compose reply",
