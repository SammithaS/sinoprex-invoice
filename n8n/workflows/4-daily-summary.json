          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "id": "7b7b59f6-e60a-5b28-b548-1d05ac7fe050",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        300
      ],
      "notes": "Edit these values once after importing (see n8n/README.md).",
      "notesInFlow": true
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $json.backend_url }}/stats",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $json.api_key }}"
            }
          ]
        },
        "options": {
          "timeout": 60000
        }
      },
      "id": "dbbd4fe0-3587-5ae2-83ca-2e9182785ed7",
      "name": "Get stats",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Daily AP summary from GET /stats.\nconst s = $input.first().json;\nconst cfg = $('Config').first().json;\nconst inr = (v) => '₹' + Number(v ?? 0).toLocaleString('en-IN');\nconst d = s.decisions ?? {};\nconst causes = Object.entries(s.exception_causes ?? {}).sort((a, b) => b[1] - a[1]).slice(0, 3);\nconst rate = s.straight_through_rate == null ? '—' : Math.round(s.straight_through_rate * 100) + '%';\nconst lines = [\n  'Good morning. Accounts payable, last 30 days:',\n  '',\n  `- Cases: ${s.runs} (${s.completed} closed)`,\n  `- Approved: ${d.APPROVED ?? 0} · Rejected: ${d.REJECTED ?? 0} · On hold: ${d.ON_HOLD ?? 0}`,\n  `- Straight-through (no human touch): ${rate}`,\n  `- Waiting for review: ${s.waiting_review} · for approval: ${s.waiting_approval} (value ${inr(s.pending_value)})`,\n  `- Posted to ERP: ${s.erp_posted} (${s.erp_verified} verified, ${s.erp_mismatches} mismatches)`,\n  causes.length ? `- Top issues: ${causes.map(([k, v]) => `${k} (${v})`).join(', ')}` : '- Top issues: none',\n  '',\n  `Dashboard: ${cfg.app_url}/dashboard`,\n  `Review queue: ${cfg.app_url}/review`,\n];\nreturn [{ json: { to: cfg.summary_to, subject: `SinoprexInvoice daily AP summary · ${s.waiting_review} waiting for review`, text: lines.join('\\n') } }];\n"
      },
      "id": "75b1aceb-a39b-5935-8c1c-768e740c066e",
      "name": "Compose",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        300
      ]
    },
    {
      "parameters": {
        "sendTo": "={{ $json.to }}",
        "subject": "={{ $json.subject }}",
        "emailType": "text",
        "message": "={{ $json.text }}",
        "options": {
          "appendAttribution": false
        }
      },
      "id": "36dbcaa1-a944-50a6-ae0b-76b2de05cf55",
      "name": "Email summary",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        880,
