      "id": "c2c3385a-7e8e-5318-aeb9-bfd3e2257594",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        300
      ],
      "notes": "Edit these values once after importing (see n8n/README.md).",
      "notesInFlow": true
