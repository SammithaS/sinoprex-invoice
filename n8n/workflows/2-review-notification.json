    {
      "parameters": {
        "jsCode": "// Rebuild exactly what Sinoprex Invoice signed: \"<timestamp>.<compact JSON body>\".\n// The backend sends compact JSON without floats, so JSON.stringify(body) gives the same bytes.\nreturn $input.all().map((item) => {\n  const j = item.json;\n  const ts = String(j.headers['x-iiq-timestamp'] ?? '');\n  const age = Math.abs(Date.now() / 1000 - Number(ts));\n  return {\n    json: {\n      ...j,\n      signed: ts + '.' + JSON.stringify(j.body),\n      given: String(j.headers['x-iiq-signature'] ?? '').toLowerCase(),\n      fresh: ts !== '' && Number.isFinite(age) && age <= 300,\n    },\n  };\n});\n"
      },
      "id": "233d5b75-3198-508d-aa80-bd32d7357b35",
      "name": "Prepare check",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "action": "hmac",
        "type": "SHA256",
        "value": "={{ $json.signed }}",
        "dataPropertyName": "expected",
        "secret": "={{ $json.webhook_secret }}",
        "encoding": "hex"
      },
      "id": "3e99f552-222c-5014-a260-531898c49cd8",
      "name": "Sign",
      "type": "n8n-nodes-base.crypto",
      "typeVersion": 1,
      "position": [
        660,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "b07cc277-54fa-5897-8d8e-41b116114aba",
              "leftValue": "={{ $json.fresh && ('sha256=' + $json.expected) === $json.given }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "05ba5603-2e2f-5204-bb1c-09b2ea58b771",
      "name": "Signed by Sinoprex Invoice?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        880,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// The email to the reviewer (or approver), with a deep link to the case.\nreturn $input.all().map((item) => {\n  const b = item.json.body;\n  const what = b.kind === 'approval' ? 'Approval needed' : b.kind === 'erp' ? 'ERP recheck needed' : 'Review needed';\n  const who = b.vendor || 'Unknown supplier';\n  const inr = b.total_inr ? ` for ₹${Number(b.total_inr).toLocaleString('en-IN')}` : '';\n  const lines = [\n    `${what}: ${who} invoice ${b.invoice_number || '(no number)'}${inr}.`,\n    '',\n    b.question ? `Question: ${b.question}` : '',\n    ...(b.exceptions ?? []).map((e) => `- ${e.category}: ${e.summary} (owner: ${e.owner})`),\n    b.approver_role ? `Approver: ${b.approver_role}${b.approver_name ? ' (' + b.approver_name + ')' : ''}` : '',\n    '',\n    `Open the case: ${b.link}`,\n    b.kind === 'approval' ? `Approvals inbox: ${b.approvals_inbox}` : `Review queue: ${b.review_queue}`,\n  ].filter((l, i, a) => l !== '' || a[i - 1] !== '');\n  return {\n    json: {\n      to: item.json.reviewer_email,\n      subject: `Sinoprex Invoice · ${what}: ${who} ${b.invoice_number || ''}`.trim(),\n      text: lines.join('\\n'),\n      run_id: b.run_id,\n      backend_url: item.json.backend_url,\n      api_key: item.json.api_key,\n    },\n  };\n});\n"
      },
      "id": "94704184-5448-5de8-9be2-be4e2060370d",
      "name": "Compose",
      "type": "n8n-nodes-base.code",
