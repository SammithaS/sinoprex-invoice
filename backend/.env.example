# Copy to backend/.env and fill in. Never commit .env.
APP_ENV=local

# Neon: Dashboard → your project → Connect → copy the connection string.
# Paste it exactly as given (postgresql://...?sslmode=require is fine).
DATABASE_URL=

# LLMs (free tiers)
# Gemini key: https://aistudio.google.com/apikey (required)
GOOGLE_API_KEY=
# Groq key: https://console.groq.com/keys (optional fallback, text PDFs only)
GROQ_API_KEY=
# Primary provider for text PDFs: gemini | groq. Scanned PDFs always use Gemini.
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GROQ_MODEL=openai/gpt-oss-120b

# RAG embeddings: local FastEmbed model, downloaded once (~65 MB) into the cache dir.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_CACHE_DIR=~/.cache/fastembed

# Tracing (optional)
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false

# File storage: local | r2
STORAGE_BACKEND=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# n8n automations
N8N_BASE_URL=
N8N_WEBHOOK_SECRET=

# Frontend origin allowed by CORS, and the shared key the Next.js server sends.
# Leave API_KEY empty to disable the check during development.
FRONTEND_ORIGIN=http://localhost:3000
API_KEY=
